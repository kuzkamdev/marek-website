---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="home">
  <h1>Marek Molenda</h1>
  <p class="role">{t('home.role')}</p>
  <p>{t('home.status')}</p>
  <a class="quick-cv" href={getRelativeLocaleUrl(lang, 'cv/')} data-testid="quick-cv">
    {t('home.quickCv')} →
  </a>
</section>

<style>
  .home {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space);
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin-block: 0 0.25em;
  }

  .role {
    font-size: 1.25rem;
    color: var(--color-accent);
    margin-block: 0 1.5em;
  }

  .quick-cv {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7em 1.4em;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 600;
    text-decoration: none;
  }

  .quick-cv:hover,
  .quick-cv:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 85%, black);
  }
</style>
