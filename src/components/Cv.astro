---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profiles } from '../data/profile';
import { getLang, useTranslations } from '../i18n/utils';
import CvHeader from './cv/CvHeader.astro';
import CvSection from './cv/CvSection.astro';
import Tags from './cv/Tags.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const p = profiles[lang];
---

<article class="cv">
  <nav class="cv-actions" aria-label="CV">
    <a href={getRelativeLocaleUrl(lang)}>← {t('cv.back')}</a>
    <button type="button" data-print>
      {t('cv.print')}
    </button>
  </nav>

  <CvHeader
    name={p.name}
    role={p.role}
    summary={p.summary}
    location={p.location}
    photoAlt={t('cv.photoAlt')}
  />

  <div class="cv-grid">
    <div class="cv-main">
      <CvSection title={t('cv.experience')} id="experience" icon="💼">
        {p.experience.map((job) => (
          <div class="item">
            <h3>
              <a href={job.url}>{job.company}</a>
            </h3>
            <ol class="timeline">
              {job.roles.map((r) => (
                <li>
                  <strong>{r.title}</strong> <span class="muted">{r.period}</span>
                </li>
              ))}
            </ol>
            <ul>
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        ))}
      </CvSection>

      <CvSection title={t('cv.projects')} id="projects" icon="🛠️">
        {p.projects.map((project) => (
          <div class="item">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <Tags items={project.tags} />
          </div>
        ))}
      </CvSection>
    </div>

    <aside class="cv-side">
      <CvSection title={t('cv.contact')} id="contact" icon="✉️">
        <ul class="plain">
          {p.contact.map((c) => (
            <li>
              <span class="muted">{c.label}:</span> <a href={c.href}>{c.text}</a>
            </li>
          ))}
        </ul>
      </CvSection>

      <CvSection title={t('cv.skills')} id="skills" icon="⚡">
        <Tags items={p.skills} />
      </CvSection>

      <CvSection title={t('cv.certificates')} id="certificates" icon="🏅">
        <ul class="plain">
          {p.certificates.map((c) => (
            <li>
              {c.name} <span class="muted">{c.date}</span>
            </li>
          ))}
        </ul>
      </CvSection>

      <CvSection title={t('cv.education')} id="education" icon="🎓">
        <ul class="plain">
          {p.education.map((e) => (
            <li>
              <strong>{e.field}</strong>
              <br />
              {e.school} <span class="muted">{e.period}</span>
            </li>
          ))}
        </ul>
      </CvSection>

      <CvSection title={t('cv.languages')} id="languages" icon="🌍">
        <ul class="plain">
          {p.languages.map((l) => (
            <li>
              {l.name} <span class="muted">{l.level}</span>
            </li>
          ))}
        </ul>
      </CvSection>

      <CvSection title={t('cv.hobbies')} id="hobbies" icon="🎯">
        <ul class="plain hobbies">
          {p.hobbies.map((h) => (
            <li>
              <span aria-hidden="true">{h.icon}</span> {h.name}
            </li>
          ))}
        </ul>
      </CvSection>
    </aside>
  </div>
</article>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 var(--space) calc(var(--space) * 2);
    display: grid;
    gap: var(--space);
  }

  .cv-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-right: 7rem;
  }

  .cv-actions a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .cv-actions a:hover {
    color: var(--color-accent);
  }

  .cv-actions button {
    font: inherit;
    font-weight: 700;
    padding: 0.55em 1.1em;
    border: 0;
    border-radius: 999px;
    background: var(--gradient-brand);
    color: var(--color-on-accent);
    cursor: pointer;
    box-shadow: 0 8px 24px rgb(52 227 180 / 0.3);
  }

  .cv-grid,
  .cv-main,
  .cv-side {
    display: grid;
    gap: var(--space);
    align-content: start;
  }

  .item + .item {
    margin-top: 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border);
  }

  h3 {
    font-size: 1.15rem;
    margin: 0 0 0.45em;
  }

  h3 a {
    color: var(--color-text);
  }

  p {
    margin: 0 0 0.75em;
    color: var(--color-muted);
  }

  ul {
    margin: 0.5em 0 0;
    padding-left: 1.2em;
  }

  li::marker {
    color: var(--color-accent);
  }

  .plain {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  /* Oś czasu stanowisk. */
  .timeline {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid rgb(52 227 180 / 0.35);
    display: grid;
    gap: 0.6rem;
  }

  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.45em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  .muted {
    color: var(--color-muted);
    font-size: 0.88em;
    white-space: nowrap;
  }

  a {
    overflow-wrap: anywhere;
  }

  /* Na telefonie kontakt trafia zaraz pod nagłówek, żeby rekruter nie musiał przewijać. */
  @media (max-width: 767.98px) {
    .cv-grid {
      display: flex;
      flex-direction: column;
    }

    .cv-main,
    .cv-side {
      display: contents;
    }

    .cv-side :global([data-testid='cv-contact']) {
      order: -1;
    }
  }

  @media (min-width: 768px) {
    .cv-grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  @media print {
    .cv-actions {
      display: none;
    }

    .cv {
      padding: 0;
      gap: 1rem;
    }

    .cv-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 1rem;
    }

    .cv-main,
    .cv-side {
      gap: 0.9rem;
    }

    p {
      color: var(--color-text);
    }

    .item + .item {
      margin-top: 0.8rem;
      padding-top: 0;
      border: 0;
    }

    .timeline li::before {
      box-shadow: none;
    }
  }
</style>
