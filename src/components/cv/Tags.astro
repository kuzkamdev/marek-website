---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<ul class="tags">
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    font-size: 0.85rem;
    padding: 0.15em 0.6em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    border-radius: 999px;
  }
</style>
