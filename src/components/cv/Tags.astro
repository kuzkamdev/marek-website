---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<ul class="tags">
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    color: #c9f7ea;
    background: rgb(52 227 180 / 0.1);
    border: 1px solid rgb(52 227 180 / 0.28);
  }

  @media print {
    li {
      color: inherit;
      background: none;
      border-color: #bbb;
    }
  }
</style>
