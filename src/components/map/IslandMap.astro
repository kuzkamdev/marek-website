---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { WORLD_HEIGHT, WORLD_WIDTH, getPlaces } from '../../data/places';
import { profiles } from '../../data/profile';
import { getLang, useTranslations } from '../../i18n/utils';
import Tags from '../cv/Tags.astro';
import IslandArt from './IslandArt.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const places = getPlaces(lang);
const profile = profiles[lang];
const cvUrl = getRelativeLocaleUrl(lang, 'cv/');
---

<div class="map" data-map>
  <div class="map-intro glass">
    <p class="eyebrow">Portfolio</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="hint js-only">{t('map.hint')}</p>
  </div>

  <div
    class="map-viewport"
    data-viewport
    role="region"
    aria-label={t('map.label')}
    aria-describedby="map-hint"
    tabindex="0"
  >
    <span id="map-hint" class="visually-hidden">
      {t('map.hint')}
    </span>
    <div
      class="map-world"
      data-world
      data-testid="map-world"
      style={`width:${WORLD_WIDTH}px;height:${WORLD_HEIGHT}px`}
    >
      <IslandArt />
      {places.map((place) => (
        <a
          class="place"
          href={`#place-${place.id}`}
          style={`left:${place.x}px;top:${place.y}px`}
          data-place={place.id}
          data-x={place.x}
          data-y={place.y}
          aria-controls={`place-${place.id}`}
        >
          <span class="place-icon" aria-hidden="true">
            {place.icon}
          </span>
          <span class="place-label">{place.title}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="map-controls js-only" role="group" aria-label={t('map.label')}>
    <button
      type="button"
      class="glass"
      data-zoom="in"
      aria-label={t('map.zoomIn')}
      title={t('map.zoomIn')}
    >
      +
    </button>
    <button
      type="button"
      class="glass"
      data-zoom="out"
      aria-label={t('map.zoomOut')}
      title={t('map.zoomOut')}
    >
      −
    </button>
    <button type="button" class="glass" data-zoom="reset">
      {t('map.reset')}
    </button>
  </div>

  <a class="quick-cv" href={cvUrl} data-testid="quick-cv">
    {t('home.quickCv')} →
  </a>

  <section class="place-panel glass" data-panel aria-label={t('map.places')}>
    {places.map((place) => (
      <article
        class="place-card"
        id={`place-${place.id}`}
        data-card={place.id}
        tabindex="-1"
        aria-labelledby={`place-${place.id}-title`}
      >
        <div class="card-head">
          <h2 id={`place-${place.id}-title`}>
            <span class="card-icon" aria-hidden="true">
              {place.icon}
            </span>
            {place.title}
          </h2>
          <button
            type="button"
            class="card-close glass js-only"
            data-close
            aria-label={t('map.close')}
          >
            ×
          </button>
        </div>
        {place.lines.map((line) => (
          <p>{line}</p>
        ))}
        {place.tags && <Tags items={place.tags} />}
        {place.links && (
          <ul class="card-links">
            {place.links.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))}
          </ul>
        )}
        <a class="card-cv" href={cvUrl}>
          {t('map.fullCv')} →
        </a>
      </article>
    ))}
  </section>
</div>

<script>
  import { PanZoom } from '../../scripts/panzoom';

  const root = document.querySelector<HTMLElement>('[data-map]');
  const viewport = root?.querySelector<HTMLElement>('[data-viewport]');
  const world = root?.querySelector<HTMLElement>('[data-world]');
  const panel = root?.querySelector<HTMLElement>('[data-panel]');

  if (root && viewport && world && panel) {
    const pz = new PanZoom(viewport, world);
    const markers = [...world.querySelectorAll<HTMLAnchorElement>('[data-place]')];
    const isNarrow = () => window.matchMedia('(max-width: 767.98px)').matches;
    let lastMarker: HTMLAnchorElement | null = null;

    // Znaczniki zachowują czytelny rozmiar niezależnie od przybliżenia.
    pz.onChange(() => world.style.setProperty('--inv-scale', String(1 / pz.scale)));

    // Start: na komputerze widać całą wyspę; na wąskim ekranie mapa jest większa
    // (czytelne miejsca), a resztę odkrywa się przesuwaniem.
    const START_MIN_SCALE = 0.5;
    const startScale = () => {
      const { width, height } = viewport.getBoundingClientRect();
      const cover = Math.max(width / pz.worldWidth, height / pz.worldHeight);
      return Math.max(pz.fitScale() * 1.1, Math.min(START_MIN_SCALE, cover));
    };
    // Środek widoku lekko powyżej środka świata, żeby wizytówka w rogu nie zasłaniała miejsc.
    const resetView = (animate: boolean) =>
      pz.centerOn(pz.worldWidth / 2, pz.worldHeight / 2 - 70, startScale(), animate);
    resetView(false);

    const markerFor = (id: string) => markers.find((m) => m.dataset.place === id) ?? null;

    // Przelot do miejsca: znacznik ląduje na środku wolnego obszaru,
    // czyli między wizytówką u góry a kartą (telefon) albo na lewo od karty (komputer).
    const intro = root.querySelector<HTMLElement>('.map-intro');
    const flyTo = (marker: HTMLAnchorElement) => {
      const scale = Math.max(pz.scale, 0.9);
      const view = viewport.getBoundingClientRect();
      const panelRect = panel.getBoundingClientRect();
      let targetX = view.width / 2;
      let targetY = view.height / 2;
      if (isNarrow()) {
        const top = intro ? intro.getBoundingClientRect().bottom - view.top : 0;
        targetY = (top + (panelRect.top - view.top)) / 2;
      } else {
        targetX = (panelRect.left - view.left) / 2;
      }
      const wx = Number(marker.dataset.x) + (view.width / 2 - targetX) / scale;
      const wy = Number(marker.dataset.y) + (view.height / 2 - targetY) / scale;
      pz.centerOn(wx, wy, scale, true);
    };

    const open = (id: string, { focus = true } = {}) => {
      const marker = markerFor(id);
      const card = panel.querySelector<HTMLElement>(`[data-card="${id}"]`);
      if (!marker || !card) return;
      panel.querySelectorAll('.place-card.is-open').forEach((c) => c.classList.remove('is-open'));
      markers.forEach((m) => m.removeAttribute('aria-current'));
      card.classList.add('is-open');
      panel.classList.add('has-open');
      marker.setAttribute('aria-current', 'true');
      lastMarker = marker;
      history.replaceState(null, '', `#place-${id}`);
      flyTo(marker);
      if (focus) card.focus({ preventScroll: true });
    };

    const close = () => {
      if (!panel.classList.contains('has-open')) return;
      panel.classList.remove('has-open');
      panel.querySelectorAll('.place-card.is-open').forEach((c) => c.classList.remove('is-open'));
      markers.forEach((m) => m.removeAttribute('aria-current'));
      history.replaceState(null, '', location.pathname + location.search);
      lastMarker?.focus({ preventScroll: true });
    };

    markers.forEach((marker) => {
      marker.addEventListener('click', (e) => {
        e.preventDefault();
        open(marker.dataset.place!);
      });
      // Miejsce osiągnięte klawiszem Tab pojawia się w oknie mapy.
      marker.addEventListener('focus', () => {
        const r = marker.getBoundingClientRect();
        const v = viewport.getBoundingClientRect();
        if (r.left < v.left || r.right > v.right || r.top < v.top || r.bottom > v.bottom) {
          pz.centerOn(Number(marker.dataset.x), Number(marker.dataset.y), pz.scale, true);
        }
      });
    });

    panel.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.zoom;
        if (action === 'in') pz.zoomBy(1.4, undefined, true);
        else if (action === 'out') pz.zoomBy(1 / 1.4, undefined, true);
        else {
          close();
          resetView(true);
        }
      });
    });

    // Klawiatura w oknie mapy: strzałki przesuwają, + i − przybliżają.
    viewport.addEventListener('keydown', (e) => {
      if (e.target !== viewport) return;
      const step = 80;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [step, 0],
        ArrowRight: [-step, 0],
        ArrowUp: [0, step],
        ArrowDown: [0, -step],
      };
      if (moves[e.key]) {
        e.preventDefault();
        pz.panBy(...moves[e.key], true);
      } else if (e.key === '+' || e.key === '=') {
        pz.zoomBy(1.25, undefined, true);
      } else if (e.key === '-') {
        pz.zoomBy(0.8, undefined, true);
      }
    });

    const initial = location.hash.match(/^#place-(\w+)$/)?.[1];
    if (initial) open(initial, { focus: false });
    root.classList.add('is-ready');
  }
</script>

<style>
  .map {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: #071a30;
  }

  :global(.site-header) {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 20;
    padding: 0.75rem;
  }

  /* Winieta: przyciemnione brzegi kierują wzrok na wyspę. */
  .map::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgb(3 8 18 / 0.6) 100%);
  }

  .glass {
    background: rgb(17 27 47 / 0.78);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(14px) saturate(140%);
    box-shadow: var(--shadow-lg);
  }

  .map-intro {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    max-width: min(24rem, calc(100% - 8rem));
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    pointer-events: none;
  }

  .eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .map-intro h1 {
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    margin: 0;
    line-height: 1.02;
    background: var(--gradient-brand);
    background-clip: text;
    color: transparent;
  }

  .role {
    display: inline-block;
    margin: 0.45rem 0 0;
    padding: 0.15em 0.7em;
    border-radius: 999px;
    background: rgb(255 181 71 / 0.14);
    color: var(--color-accent-2);
    font-weight: 600;
    font-size: 0.85rem;
  }

  /* Przy otwartej karcie wizytówka się zmniejsza, żeby zostawić miejsce na mapę. */
  .map:has(.has-open) .hint {
    display: none;
  }

  .hint {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .map-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    user-select: none;
  }

  .map-viewport:focus-visible {
    outline: 3px solid var(--color-accent-2);
    outline-offset: -3px;
  }

  .map-viewport:global(.is-dragging) {
    cursor: grabbing;
  }

  .map-world {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  .map-world:global(.is-animating) {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .place {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transform: translate(-50%, -50%) scale(clamp(0.9, var(--inv-scale, 1), 2.2));
    text-decoration: none;
    color: var(--color-text);
  }

  .place-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    font-size: 1.9rem;
    border-radius: 50%;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      var(--gradient-brand) border-box;
    border: 3px solid transparent;
    box-shadow:
      0 0 0 6px rgb(52 227 180 / 0.12),
      0 10px 24px rgb(0 0 0 / 0.5);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Pulsujący pierścień zachęca do kliknięcia. */
  .place-icon::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: pulse 2.8s ease-out infinite;
  }

  .place-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.2em 0.75em;
    border-radius: 999px;
    background: rgb(10 17 32 / 0.85);
    border: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .place:hover .place-icon,
  .place:focus-visible .place-icon {
    transform: translateY(-4px) scale(1.06);
    box-shadow:
      0 0 0 8px rgb(52 227 180 / 0.22),
      0 0 32px rgb(52 227 180 / 0.55);
  }

  .place[aria-current] .place-icon {
    background:
      linear-gradient(#3a2a10, #3a2a10) padding-box,
      linear-gradient(120deg, #ffb547, #ff7a59) border-box;
    box-shadow:
      0 0 0 8px rgb(255 181 71 / 0.25),
      0 0 36px rgb(255 181 71 / 0.6);
  }

  .place[aria-current] .place-label {
    border-color: var(--color-accent-2);
    color: var(--color-accent-2);
  }

  .place:focus-visible {
    outline: none;
  }

  .place:focus-visible .place-label {
    outline: 3px solid var(--color-accent-2);
  }

  .map-controls {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 10;
    display: flex;
    gap: 0.4rem;
  }

  .map-controls button,
  .card-close {
    min-width: 2.75rem;
    min-height: 2.75rem;
    font: inherit;
    font-weight: 700;
    border-radius: 0.8rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .map-controls button:hover,
  .card-close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .map-controls button[data-zoom='reset'] {
    padding: 0 0.9rem;
  }

  @media (max-width: 767.98px) {
    .map-controls {
      flex-direction: column;
      align-items: flex-end;
      bottom: 4.5rem;
    }
  }

  .quick-cv {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 10;
    padding: 0.8em 1.35em;
    border-radius: 999px;
    background: var(--gradient-brand);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    box-shadow:
      0 10px 30px rgb(52 227 180 / 0.35),
      0 2px 6px rgb(0 0 0 / 0.4);
    transition: transform 0.2s ease;
  }

  .quick-cv:hover {
    transform: translateY(-2px);
  }

  .place-panel {
    position: absolute;
    z-index: 15;
    overflow-y: auto;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 58dvh;
    border-radius: 1.4rem 1.4rem 0 0;
    padding: 1.25rem 1.25rem 1.75rem;
  }

  /* Pasek gradientu u góry karty. */
  .place-panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--gradient-brand);
  }

  :global(.js) .place-card {
    animation: card-in 0.35s ease-out;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .place-card h2 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    line-height: 1.1;
  }

  .card-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    font-size: 1.4rem;
    background: rgb(52 227 180 / 0.14);
  }

  .place-card:focus {
    outline: none;
  }

  .place-card p {
    margin: 0 0 0.7rem;
    color: var(--color-muted);
  }

  .place-card p:first-of-type {
    color: var(--color-text);
  }

  .card-links {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
    display: grid;
    gap: 0.5rem;
  }

  .card-links a {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: 0.7rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .card-links a:hover {
    border-color: var(--color-accent);
  }

  .card-cv {
    display: inline-block;
    margin-top: 0.9rem;
    font-weight: 700;
    color: var(--color-accent-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.9);
      opacity: 0.8;
    }

    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (min-width: 768px) {
    .place-panel {
      left: auto;
      top: 4.5rem;
      right: 0.75rem;
      bottom: auto;
      width: 26rem;
      max-height: calc(100dvh - 10rem);
      border-radius: 1.4rem;
    }
  }

  /* Z JavaScriptem: panel pokazuje jedną otwartą kartę. */
  :global(.js) .place-panel:not(.has-open),
  :global(.js) .place-card:not(.is-open) {
    display: none;
  }

  /* Bez JavaScriptu: zamiast mapy zwykła lista miejsc i link do CV. */
  :global(html:not(.js)) .js-only {
    display: none;
  }

  :global(html:not(.js)) .map {
    height: auto;
    overflow: visible;
    background: none;
    padding: 9rem 1rem 6rem;
  }

  :global(html:not(.js)) .map::after,
  :global(html:not(.js)) .map-viewport {
    display: none;
  }

  :global(html:not(.js)) .place-panel {
    position: relative;
    max-width: 40rem;
    max-height: none;
    width: auto;
    margin: 0 auto;
    border-radius: 1.4rem;
    display: grid;
    gap: 2.5rem;
  }

  :global(html:not(.js)) .quick-cv {
    position: fixed;
  }
</style>
