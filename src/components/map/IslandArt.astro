---
import {
  WORLD_HEIGHT,
  WORLD_WIDTH,
  islandShape,
  islets,
  lakeShape,
  mountainLayers,
  peaks,
  riverPath,
  rocks,
  routePath,
  trees,
} from '../../data/island';

// Grafika wyspy w stylu ilustrowanej mapy o zmierzchu. Geometria (kształty, lasy)
// powstaje w czasie budowania w src/data/island.ts; tu są tylko kolory i detale.
// Animacje wyłącza globalna reguła prefers-reduced-motion w Base.astro.

const mountainFills = ['#2f7d5b', '#4b8f64', '#7c8f73', '#a9a392', '#eef3f7'];
const pineTones = [
  ['#164f3b', '#23704f'],
  ['#1a5a43', '#2c7e57'],
  ['#133f33', '#1f6347'],
];
const roundTones = [
  ['#1f6b47', '#3c9a5e'],
  ['#2a7a49', '#58ad62'],
  ['#1c5f45', '#348a59'],
];

// Fale-znaczki na otwartym morzu (z dala od wyspy).
const waveMarks = [
  [120, 140],
  [300, 70],
  [560, 40],
  [1250, 50],
  [1420, 210],
  [1540, 480],
  [1500, 640],
  [1330, 940],
  [1040, 965],
  [700, 960],
  [380, 950],
  [80, 520],
  [60, 360],
  [1560, 880],
].map(([x, y], i) => ({ x, y, d: (i % 5) * 0.9 }));

const sparkles = Array.from({ length: 26 }, (_, i) => ({
  x: (i * 389 + 40) % WORLD_WIDTH,
  y: (i * 271 + 25) % WORLD_HEIGHT,
  d: (i % 7) * 0.8,
}));

const fireflies = Array.from({ length: 16 }, (_, i) => ({
  x: 380 + ((i * 197) % 860),
  y: 300 + ((i * 131) % 460),
  d: (i % 6) * 0.6,
}));

const clouds = [
  { x: 180, y: 120, s: 1.2, d: 0 },
  { x: 1180, y: 90, s: 1, d: -30 },
  { x: 1380, y: 760, s: 0.9, d: -60 },
];
---

<svg
  class="island-art"
  viewBox={`0 0 ${WORLD_WIDTH} ${WORLD_HEIGHT}`}
  width={WORLD_WIDTH}
  height={WORLD_HEIGHT}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="ia-sea" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#0d4a68"></stop>
      <stop offset="50%" stop-color="#0a3150"></stop>
      <stop offset="100%" stop-color="#06172b"></stop>
    </radialGradient>
    <radialGradient id="ia-shelf" cx="50%" cy="50%" r="50%">
      <stop offset="70%" stop-color="#2fc4b5"></stop>
      <stop offset="100%" stop-color="#1a8d98"></stop>
    </radialGradient>
    <linearGradient id="ia-sand" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f6e2b0"></stop>
      <stop offset="100%" stop-color="#d9b077"></stop>
    </linearGradient>
    <linearGradient id="ia-grass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3f9a63"></stop>
      <stop offset="55%" stop-color="#2e8256"></stop>
      <stop offset="100%" stop-color="#1f6449"></stop>
    </linearGradient>
    <radialGradient id="ia-meadow" cx="40%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#7cc373"></stop>
      <stop offset="60%" stop-color="#55a865"></stop>
      <stop offset="100%" stop-color="#3f9a63" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="ia-light" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fff6d8" stop-opacity="0.16"></stop>
      <stop offset="45%" stop-color="#fff6d8" stop-opacity="0"></stop>
      <stop offset="100%" stop-color="#0a1b3a" stop-opacity="0.38"></stop>
    </linearGradient>
    <linearGradient id="ia-lake" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#5fd7d0"></stop>
      <stop offset="100%" stop-color="#1f8fa6"></stop>
    </linearGradient>
    <radialGradient id="ia-moon" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff3c9" stop-opacity="0.22"></stop>
      <stop offset="100%" stop-color="#fff3c9" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="ia-beam" cx="0" cy="0.5" r="1">
      <stop offset="0%" stop-color="#ffe7a8" stop-opacity="0.7"></stop>
      <stop offset="100%" stop-color="#ffe7a8" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="ia-fire" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffd27a" stop-opacity="0.8"></stop>
      <stop offset="100%" stop-color="#ff8a3d" stop-opacity="0"></stop>
    </radialGradient>
    <clipPath id="ia-land-clip">
      <path d={islandShape.beach}></path>
    </clipPath>
    <filter id="ia-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
    <g id="ia-pine">
      <path d="M0,-30 L13,2 L-13,2 Z"></path>
      <path d="M0,-42 L10,-14 L-10,-14 Z"></path>
    </g>
  </defs>

  <!-- Morze: głębia, izobaty, poświata księżyca -->
  <rect width={WORLD_WIDTH} height={WORLD_HEIGHT} fill="url(#ia-sea)"></rect>
  <ellipse cx="1260" cy="180" rx="380" ry="200" fill="url(#ia-moon)"></ellipse>
  <g fill="none" stroke="#7fe3ff" stroke-linejoin="round">
    {islandShape.isobaths.map((d, i) => (
      <path
        d={d}
        stroke-opacity={0.13 - i * 0.03}
        stroke-width="2"
        stroke-dasharray={i === 2 ? '6 10' : undefined}
      />
    ))}
  </g>
  <g class="sparkles">
    {sparkles.map((s) => (
      <path
        class="sparkle"
        style={`animation-delay:-${s.d}s`}
        d={`M${s.x - 5},${s.y} L${s.x + 5},${s.y} M${s.x},${s.y - 5} L${s.x},${s.y + 5}`}
        stroke="#d9fbff"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    ))}
  </g>
  <g fill="none" stroke="#9fe9ff" stroke-opacity="0.4" stroke-width="2.4" stroke-linecap="round">
    {waveMarks.map((w) => (
      <path
        class="wave"
        style={`animation-delay:-${w.d}s`}
        d={`M${w.x},${w.y} q10,-8 20,0 t20,0 M${w.x + 12},${w.y + 10} q8,-6 16,0`}
      />
    ))}
  </g>

  <!-- Wysepki i skały -->
  {islets.map((i) => (
    <g>
      <path d={i.shelf} fill="#2fc4b5" opacity="0.3" />
      <path d={i.beach} fill="#ecd29b" />
      <path d={i.grass} fill="#3f9a63" />
    </g>
  ))}
  {rocks.map((r) => (
    <g transform={`translate(${r.x} ${r.y}) scale(${r.s})`}>
      <ellipse rx="26" ry="9" cy="6" fill="#bff3ff" opacity="0.18" />
      <path d="M-16,6 L-10,-8 L0,-14 L12,-6 L17,6 Z" fill="#5d6b80" />
      <path d="M0,-14 L12,-6 L17,6 L4,6 Z" fill="#3c475a" />
    </g>
  ))}

  <!-- Wyspa: szelf, piana, cień, plaża, trawa -->
  <path d={islandShape.shelfDeep} fill="#127386" opacity="0.45"></path>
  <path d={islandShape.shelf} fill="url(#ia-shelf)" opacity="0.55"></path>
  <path
    class="surf"
    d={islandShape.surf}
    fill="none"
    stroke="#e9fdff"
    stroke-opacity="0.55"
    stroke-width="3"
    stroke-dasharray="14 9"
  ></path>
  <path d={islandShape.beach} transform="translate(8 16)" fill="#04212f" opacity="0.45"></path>
  <path d={islandShape.beach} fill="url(#ia-sand)"></path>
  <path d={islandShape.grass} fill="url(#ia-grass)"></path>
  <path d={islandShape.meadow} fill="url(#ia-meadow)" opacity="0.8"></path>

  <!-- Góra z warstwicami -->
  <g>
    <path d={mountainLayers[0]} transform="translate(10 14)" fill="#0d3a2c" opacity="0.4"></path>
    {mountainLayers.map((d, i) => (
      <path
        d={d}
        fill={mountainFills[i]}
        stroke="#0d3a2c"
        stroke-opacity="0.25"
        stroke-width="1.5"
      />
    ))}
  </g>

  <g>
    {peaks.map(([x, y, w, h]) => (
      <g transform={`translate(${x} ${y})`}>
        <ellipse cx="6" cy="2" rx={w * 0.55} ry="8" fill="#0d3a2c" opacity="0.35" />
        <path d={`M${-w / 2},0 L0,${-h} L${w / 2},0 Z`} fill="#8b8f8a" />
        <path d={`M0,${-h} L${w / 2},0 L${w * 0.08},0 Z`} fill="#5f6a6a" />
        <path
          d={`M${-w * 0.16},${-h * 0.68} L0,${-h} L${w * 0.16},${-h * 0.68} L${w * 0.06},${-h * 0.6} L0,${-h * 0.7} L${-w * 0.07},${-h * 0.6} Z`}
          fill="#f4f8fb"
        />
      </g>
    ))}
  </g>

  <!-- Jezioro i rzeka -->
  <path d={riverPath} fill="none" stroke="#d9b077" stroke-width="14" stroke-linecap="round"></path>
  <path d={riverPath} fill="none" stroke="#3cb6c2" stroke-width="8" stroke-linecap="round"></path>
  <path d={lakeShape.shore} fill="#e1c58e"></path>
  <path d={lakeShape.water} fill="url(#ia-lake)"></path>
  <path
    d="M1080,440 q8,-5 16,0 M1112,456 q8,-5 16,0"
    fill="none"
    stroke="#e9fdff"
    stroke-opacity="0.7"
    stroke-width="2"
    stroke-linecap="round"
  ></path>

  <!-- Ścieżka (bez zmian w wyglądzie: poświata + maszerujące kropki) -->
  <path
    d={routePath}
    fill="none"
    stroke="#c99a5b"
    stroke-opacity="0.55"
    stroke-width="22"
    stroke-linecap="round"
  ></path>
  <path
    d={routePath}
    fill="none"
    stroke="#ffb547"
    stroke-opacity="0.35"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter="url(#ia-glow)"
  ></path>
  <path
    class="route"
    d={routePath}
    fill="none"
    stroke="#ffd27a"
    stroke-width="5"
    stroke-dasharray="2 16"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  <!-- Lasy -->
  <g>
    {trees.map((t) => (
      <g transform={`translate(${t.x} ${t.y}) scale(${t.s.toFixed(2)})`}>
        <ellipse cx="4" cy="4" rx="13" ry="5" fill="#0b2e24" opacity="0.35" />
        {t.kind === 'pine' ? (
          <>
            <rect x="-2" y="0" width="4" height="7" fill="#5b3d22" />
            <use href="#ia-pine" fill={pineTones[t.tone][0]} />
            <path d="M0,-42 L10,-14 L4,-14 L13,2 L1,2 Z" fill={pineTones[t.tone][1]} />
          </>
        ) : (
          <>
            <rect x="-2" y="-4" width="4" height="10" fill="#6a4628" />
            <circle cy="-14" r="13" fill={roundTones[t.tone][0]} />
            <circle cx="-4" cy="-18" r="7" fill={roundTones[t.tone][1]} />
          </>
        )}
      </g>
    ))}
  </g>

  <!-- Budynki przy miejscach -->
  <!-- O mnie: domek z dymem -->
  <g transform="translate(735 430)">
    <ellipse cx="4" cy="20" rx="34" ry="8" fill="#0b2e24" opacity="0.35"></ellipse>
    <rect x="-24" y="-6" width="48" height="26" fill="#efe3c8"></rect>
    <rect x="0" y="-6" width="24" height="26" fill="#d6c7a6"></rect>
    <path d="M-30,-4 L0,-28 L30,-4 Z" fill="#c4573d"></path>
    <path d="M0,-28 L30,-4 L14,-4 Z" fill="#a3432f"></path>
    <rect x="12" y="-30" width="7" height="14" fill="#7a5b4a"></rect>
    <rect x="-16" y="2" width="9" height="9" fill="#ffd27a"></rect>
    <rect x="6" y="6" width="9" height="14" fill="#7a5130"></rect>
    <g class="smoke" fill="#e9eef8">
      <circle cx="16" cy="-38" r="5" opacity="0.5"></circle>
      <circle cx="22" cy="-50" r="7" opacity="0.35"></circle>
      <circle cx="30" cy="-64" r="9" opacity="0.2"></circle>
    </g>
  </g>

  <!-- Doświadczenie: zamek na wzgórzu -->
  <g transform="translate(1075 290)">
    <ellipse cy="26" rx="60" ry="16" fill="#3f9a63"></ellipse>
    <ellipse cx="6" cy="30" rx="46" ry="9" fill="#0b2e24" opacity="0.3"></ellipse>
    <rect x="-30" y="-8" width="60" height="34" fill="#a7b3c6"></rect>
    <rect x="6" y="-8" width="24" height="34" fill="#8792a8"></rect>
    <path d="M-30,-8 h8 v-6 h8 v6 h8 v-6 h8 v6 h8 v-6 h8 v6 h8 v-6 h8 v6" fill="#a7b3c6"></path>
    <rect x="-42" y="-26" width="18" height="52" fill="#b7c2d3"></rect>
    <rect x="24" y="-26" width="18" height="52" fill="#8792a8"></rect>
    <path d="M-45,-26 L-33,-44 L-21,-26 Z M21,-26 L33,-44 L45,-26 Z" fill="#5a4fb0"></path>
    <rect x="-8" y="8" width="16" height="18" rx="8" fill="#3b2a1f"></rect>
    <rect x="-36" y="-14" width="6" height="8" fill="#ffd27a"></rect>
    <rect x="30" y="-14" width="6" height="8" fill="#ffd27a"></rect>
    <path d="M-33,-44 v-16" stroke="#e9eef8" stroke-width="2"></path>
    <path class="flag" d="M-33,-60 l16,4 l-16,4 z" fill="#ffb547"></path>
  </g>

  <!-- Projekty: warsztat z kołem zębatym -->
  <g transform="translate(1275 585)">
    <ellipse cx="4" cy="22" rx="40" ry="8" fill="#0b2e24" opacity="0.35"></ellipse>
    <rect x="-30" y="-6" width="60" height="28" fill="#9a6a40"></rect>
    <rect x="4" y="-6" width="26" height="28" fill="#7f5533"></rect>
    <path d="M-36,-4 L-24,-22 L36,-22 L36,-4 Z" fill="#4c5d7a"></path>
    <rect x="-22" y="4" width="20" height="18" fill="#3b2a1f"></rect>
    <rect x="10" y="2" width="12" height="9" fill="#ffd27a"></rect>
    <g transform="translate(18 -34)">
      <g class="gear">
        <circle r="11" fill="#ffb547"></circle>
        <path
          d="M-3,-15 h6 v5 h-6z M-3,10 h6 v5 h-6z M-15,-3 v6 h5 v-6z M10,-3 v6 h5 v-6z"
          fill="#ffb547"
        ></path>
        <circle r="4" fill="#7f5533"></circle>
      </g>
    </g>
  </g>

  <!-- Hobby: namiot i ognisko -->
  <g transform="translate(520 228)">
    <ellipse cx="4" cy="16" rx="34" ry="7" fill="#0b2e24" opacity="0.35"></ellipse>
    <path d="M-28,16 L0,-22 L28,16 Z" fill="#e2574c"></path>
    <path d="M0,-22 L28,16 L8,16 Z" fill="#b8433a"></path>
    <path d="M-6,16 L0,2 L6,16 Z" fill="#3b2a1f"></path>
    <g transform="translate(46 12)">
      <circle class="fire-glow" r="22" fill="url(#ia-fire)"></circle>
      <path
        d="M-8,6 L8,2 M-8,2 L8,6"
        stroke="#6a4628"
        stroke-width="3"
        stroke-linecap="round"
      ></path>
      <path class="flame" d="M0,-12 C6,-4 6,2 0,4 C-6,2 -6,-4 0,-12 Z" fill="#ffb547"></path>
      <path d="M0,-5 C3,-1 3,2 0,3 C-3,2 -3,-1 0,-5 Z" fill="#fff1b8"></path>
    </g>
  </g>

  <!-- Kontakt: latarnia i pomost -->
  <g transform="translate(455 845)">
    <path class="beam" d="M0,-58 L420,-150 L420,40 Z" fill="url(#ia-beam)"></path>
    <ellipse cy="10" rx="30" ry="10" fill="#5d6b80"></ellipse>
    <rect x="-12" y="-50" width="24" height="60" rx="4" fill="#f4f1ea"></rect>
    <rect x="-12" y="-34" width="24" height="10" fill="#e2574c"></rect>
    <rect x="-12" y="-10" width="24" height="10" fill="#e2574c"></rect>
    <rect x="-9" y="-66" width="18" height="16" rx="3" fill="#ffe7a8" filter="url(#ia-glow)"></rect>
    <path d="M-14,-66 L0,-80 L14,-66 Z" fill="#2a3550"></path>
  </g>
  <g transform="translate(600 830)">
    <path d="M0,0 L70,22" stroke="#7a5130" stroke-width="9" stroke-linecap="round"></path>
    <path d="M18,8 v12 M44,16 v12 M66,22 v12" stroke="#5b3d22" stroke-width="3"></path>
  </g>

  <!-- Oświetlenie całej wyspy (światło z lewej góry) -->
  <rect
    width={WORLD_WIDTH}
    height={WORLD_HEIGHT}
    fill="url(#ia-light)"
    clip-path="url(#ia-land-clip)"
  ></rect>

  <g class="fireflies">
    {fireflies.map((f) => (
      <circle
        class="firefly"
        style={`animation-delay:-${f.d}s`}
        cx={f.x}
        cy={f.y}
        r="2.6"
        fill="#ffd27a"
        filter="url(#ia-glow)"
      />
    ))}
  </g>

  <!-- Łódki -->
  <g transform="translate(1390 830)">
    <g class="boat">
      <path
        d="M-6,18 q40,10 82,0"
        fill="none"
        stroke="#bff3ff"
        stroke-opacity="0.35"
        stroke-width="2"
      ></path>
      <path d="M0,0 L70,0 L58,16 L12,16 Z" fill="#7a5130"></path>
      <path d="M34,0 L34,-54 L62,-8 Z" fill="#f4f1ea"></path>
      <path d="M32,-4 L32,-40 L10,-8 Z" fill="#9b8cff"></path>
    </g>
  </g>
  <g transform="translate(110 600) scale(0.7)">
    <g class="boat" style="animation-delay:-2s">
      <path d="M0,0 L56,0 L46,12 L10,12 Z" fill="#6a4628"></path>
      <path d="M28,0 L28,-40 L50,-6 Z" fill="#f4f1ea"></path>
    </g>
  </g>

  <!-- Chmury nad mapą -->
  <g class="clouds">
    {clouds.map((c) => (
      <g transform={`translate(${c.x} ${c.y}) scale(${c.s})`}>
        <g class="cloud" style={`animation-delay:${c.d}s`}>
          <g fill="#020a16" opacity="0.1" transform="translate(30 60)">
            <ellipse rx="70" ry="22" />
            <ellipse cx="40" cy="-10" rx="50" ry="22" />
          </g>
          <g fill="#f2f6ff" opacity="0.3">
            <ellipse rx="70" ry="22" />
            <ellipse cx="-30" cy="-12" rx="36" ry="22" />
            <ellipse cx="18" cy="-22" rx="44" ry="28" />
            <ellipse cx="54" cy="-6" rx="34" ry="20" />
          </g>
        </g>
      </g>
    ))}
  </g>

  <!-- Róża wiatrów -->
  <g transform="translate(1495 905)" opacity="0.8">
    <circle r="44" fill="none" stroke="#cfe8ff" stroke-opacity="0.35" stroke-width="1.5"></circle>
    <circle
      r="36"
      fill="none"
      stroke="#cfe8ff"
      stroke-opacity="0.2"
      stroke-dasharray="2 5"
    ></circle>
    <path
      d="M0,-52 L8,-8 L0,0 Z M0,52 L-8,8 L0,0 Z M52,0 L8,8 L0,0 Z M-52,0 L-8,-8 L0,0 Z"
      fill="#e9eef8"
    ></path>
    <path
      d="M0,-52 L-8,-8 L0,0 Z M0,52 L8,8 L0,0 Z M52,0 L8,-8 L0,0 Z M-52,0 L-8,8 L0,0 Z"
      fill="#7d8db0"
    ></path>
    <path d="M0,-52 L8,-8 L0,0 Z" fill="#ffb547"></path>
    <text
      y="-58"
      text-anchor="middle"
      fill="#e9eef8"
      font-size="14"
      font-family="var(--font-display)"
      font-weight="700"
    >
      N
    </text>
  </g>
</svg>

<style>
  .island-art {
    display: block;
  }

  .wave {
    animation: drift 6s ease-in-out infinite;
  }

  .sparkle {
    animation: twinkle 4.2s ease-in-out infinite;
  }

  .surf {
    animation: march 9s linear infinite;
  }

  .route {
    animation: march 2.4s linear infinite;
  }

  .firefly {
    animation: twinkle 3.6s ease-in-out infinite;
  }

  .beam {
    transform-origin: 0 -58px;
    animation: sweep 7s ease-in-out infinite alternate;
  }

  .boat {
    animation: bob 4s ease-in-out infinite;
  }

  .smoke {
    animation: rise 5s ease-in-out infinite;
  }

  .flame,
  .fire-glow {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker 0.9s ease-in-out infinite alternate;
  }

  .fire-glow {
    transform-origin: center;
  }

  .gear {
    animation: spin 12s linear infinite;
  }

  .flag {
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: wave-flag 1.6s ease-in-out infinite alternate;
  }

  .cloud {
    animation: cloud 90s linear infinite alternate;
  }

  @keyframes drift {
    50% {
      transform: translateX(14px);
      opacity: 0.45;
    }
  }

  @keyframes march {
    to {
      stroke-dashoffset: -36;
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.12;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes sweep {
    from {
      transform: rotate(-14deg);
    }

    to {
