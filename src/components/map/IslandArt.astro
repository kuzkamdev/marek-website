---
import { WORLD_HEIGHT, WORLD_WIDTH, placePositions } from '../../data/places';

// Grafika wyspy: nocna sceneria z ożywieniem (fale, latarnia, łódka, świetliki).
// Animacje wyłącza globalna reguła prefers-reduced-motion w Base.astro.
const order = ['hobbies', 'experience', 'about', 'projects', 'contact'] as const;
const route = order
  .map((id) => placePositions.find((p) => p.id === id)!)
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y + 40}`)
  .join(' ');

const shore =
  'M300,260 C420,150 640,170 780,190 C950,160 1150,180 1290,300 C1400,400 1390,560 1330,680 C1260,820 1050,860 860,850 C700,880 520,880 400,800 C270,720 220,600 230,470 C235,380 250,310 300,260 Z';
const land =
  'M330,290 C440,200 640,215 780,230 C950,205 1130,220 1250,320 C1350,410 1345,560 1290,660 C1225,780 1040,815 860,810 C705,835 540,835 425,765 C305,690 265,590 272,475 C276,395 290,330 330,290 Z';

const pines = [
  [330, 380, 1],
  [362, 430, 0.85],
  [300, 480, 1.1],
  [760, 300, 0.9],
  [800, 255, 1.1],
  [845, 310, 0.8],
  [1255, 420, 1],
  [1295, 470, 0.85],
  [1215, 475, 0.95],
  [880, 720, 1],
  [930, 762, 0.8],
  [700, 650, 0.9],
  [385, 610, 1.05],
  [1060, 760, 0.9],
];
const waves = Array.from({ length: 22 }, (_, i) => ({
  x: (i * 377 + 90) % WORLD_WIDTH,
  y: 40 + ((i * 263) % (WORLD_HEIGHT - 80)),
  d: (i % 5) * 0.7,
}));
const fireflies = Array.from({ length: 18 }, (_, i) => ({
  x: 360 + ((i * 197) % 880),
  y: 290 + ((i * 131) % 480),
  d: (i % 6) * 0.6,
}));
const stars = Array.from({ length: 70 }, (_, i) => ({
  x: (i * 229) % WORLD_WIDTH,
  y: (i * 157) % WORLD_HEIGHT,
  r: 0.8 + (i % 3) * 0.5,
}));
---

<svg
  class="island-art"
  viewBox={`0 0 ${WORLD_WIDTH} ${WORLD_HEIGHT}`}
  width={WORLD_WIDTH}
  height={WORLD_HEIGHT}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="ia-sea" cx="50%" cy="48%" r="75%">
      <stop offset="0%" stop-color="#13507a"></stop>
      <stop offset="55%" stop-color="#0b2f52"></stop>
      <stop offset="100%" stop-color="#071a30"></stop>
    </radialGradient>
    <linearGradient id="ia-sand" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f3d79b"></stop>
      <stop offset="100%" stop-color="#c8955a"></stop>
    </linearGradient>
    <linearGradient id="ia-land" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3cbf8f"></stop>
      <stop offset="60%" stop-color="#23856a"></stop>
      <stop offset="100%" stop-color="#175c4c"></stop>
    </linearGradient>
    <radialGradient id="ia-hill" cx="40%" cy="35%" r="70%">
      <stop offset="0%" stop-color="#5fd6a5"></stop>
      <stop offset="100%" stop-color="#2a9474"></stop>
    </radialGradient>
    <radialGradient id="ia-beam" cx="0" cy="0.5" r="1">
      <stop offset="0%" stop-color="#ffe7a8" stop-opacity="0.75"></stop>
      <stop offset="100%" stop-color="#ffe7a8" stop-opacity="0"></stop>
    </radialGradient>
    <filter id="ia-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
    <filter id="ia-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="22"></feGaussianBlur>
    </filter>
  </defs>

  <rect width={WORLD_WIDTH} height={WORLD_HEIGHT} fill="url(#ia-sea)"></rect>
  <g class="stars">
    {stars.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} fill="#cfe8ff" opacity="0.35" />
    ))}
  </g>
  <g class="waves">
    {waves.map((w) => (
      <path
        class="wave"
        style={`animation-delay:-${w.d}s`}
        d={`M${w.x},${w.y} q18,-12 36,0 t36,0`}
        fill="none"
        stroke="#7fd6ff"
        stroke-opacity="0.35"
        stroke-width="3"
        stroke-linecap="round"
      />
    ))}
  </g>

  <path
    d={shore}
    transform="translate(18 28)"
    fill="#020a16"
    opacity="0.55"
    filter="url(#ia-shadow)"
  ></path>
  <path d={shore} fill="none" stroke="#bfefff" stroke-opacity="0.14" stroke-width="26"></path>
  <path d={shore} fill="none" stroke="#e6f9ff" stroke-opacity="0.35" stroke-width="5"></path>
  <path d={shore} fill="url(#ia-sand)"></path>
  <path d={land} fill="url(#ia-land)"></path>
  <ellipse cx="900" cy="420" rx="170" ry="78" fill="url(#ia-hill)" opacity="0.85"></ellipse>
  <ellipse cx="560" cy="360" rx="120" ry="56" fill="url(#ia-hill)" opacity="0.8"></ellipse>
  <ellipse cx="1080" cy="640" rx="110" ry="46" fill="url(#ia-hill)" opacity="0.6"></ellipse>

  <path
    d={route}
    fill="none"
    stroke="#ffb547"
    stroke-opacity="0.35"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter="url(#ia-glow)"
  ></path>
  <path
    class="route"
    d={route}
    fill="none"
    stroke="#ffd27a"
    stroke-width="5"
    stroke-dasharray="2 16"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  {pines.map(([x, y, s]) => (
    <g transform={`translate(${x} ${y}) scale(${s})`}>
      <rect x="-3" y="4" width="6" height="12" fill="#5b3d22" />
      <path d="M0,-34 L18,6 L-18,6 Z" fill="#14533f" />
      <path d="M0,-34 L18,6 L2,6 Z" fill="#1d6e54" />
      <path d="M0,-48 L13,-16 L-13,-16 Z" fill="#1a6a50" />
    </g>
  ))}

  <g class="fireflies">
    {fireflies.map((f) => (
      <circle
        class="firefly"
        style={`animation-delay:-${f.d}s`}
        cx={f.x}
        cy={f.y}
        r="3"
        fill="#ffd27a"
        filter="url(#ia-glow)"
      />
    ))}
  </g>

  <g transform="translate(470 880)">
    <path class="beam" d="M0,-58 L420,-150 L420,40 Z" fill="url(#ia-beam)"></path>
    <rect x="-12" y="-50" width="24" height="60" rx="4" fill="#f4f1ea"></rect>
    <rect x="-12" y="-34" width="24" height="10" fill="#e2574c"></rect>
    <rect x="-12" y="-10" width="24" height="10" fill="#e2574c"></rect>
    <rect x="-9" y="-66" width="18" height="16" rx="3" fill="#ffe7a8" filter="url(#ia-glow)"></rect>
    <path d="M-14,-66 L0,-80 L14,-66 Z" fill="#2a3550"></path>
  </g>

  <g transform="translate(1390 830)">
    <g class="boat">
      <path d="M0,0 L70,0 L58,16 L12,16 Z" fill="#7a5130"></path>
      <path d="M34,0 L34,-54 L62,-8 Z" fill="#f4f1ea"></path>
      <path d="M32,-4 L32,-40 L10,-8 Z" fill="#9b8cff"></path>
    </g>
  </g>
</svg>

<style>
  .island-art {
    display: block;
  }

  .wave {
    animation: drift 6s ease-in-out infinite;
  }

  .route {
    animation: march 2.4s linear infinite;
  }

  .firefly {
    animation: twinkle 3.6s ease-in-out infinite;
  }

  .beam {
    transform-origin: 0 -58px;
    animation: sweep 7s ease-in-out infinite alternate;
  }

  .boat {
    animation: bob 4s ease-in-out infinite;
  }

  @keyframes drift {
    50% {
      transform: translateX(18px);
      opacity: 0.4;
    }
  }

  @keyframes march {
    to {
      stroke-dashoffset: -36;
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes sweep {
    from {
      transform: rotate(-14deg);
    }

    to {
      transform: rotate(10deg);
    }
  }

  @keyframes bob {
    50% {
      transform: translateY(8px) rotate(2deg);
    }
  }
</style>
